# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# catch-all — contents of any "fixtures/*/real/" directory (any test suite,
# any depth) are real data by convention here and must never be committed,
# even before anyone remembers to add a specific rule for it. Matches
# contents (trailing /*), not the directory itself — excluding the directory
# would make a later "!.../.gitkeep" exception unable to re-include anything
# (git cannot re-include a file whose parent directory is excluded).
**/fixtures/*/real/*

# importer — real financial/POS files must never be committed
/imports/incoming/*
!/imports/incoming/.gitkeep
/imports/processed/*
!/imports/processed/.gitkeep
/imports/rejected/*
!/imports/rejected/.gitkeep
/imports/review/*
!/imports/review/.gitkeep
/imports/duplicates/*
!/imports/duplicates/.gitkeep
/imports/logs/*
!/imports/logs/.gitkeep

# real bank statements dropped locally for PR2A/PR3 test development —
# never committed (see README_IMPORTER.md "Fixtures et anonymisation")
/lib/importer/__tests__/fixtures/bank/real/*
!/lib/importer/__tests__/fixtures/bank/real/.gitkeep

# real AddicTill POS exports dropped locally for PR3 test development —
# never committed (contains real business sales data)
/lib/importer/__tests__/fixtures/pos/real/*
!/lib/importer/__tests__/fixtures/pos/real/.gitkeep
