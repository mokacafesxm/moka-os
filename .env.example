# MÖKA importer — variables d'environnement (voir README_IMPORTER.md et
# docs/ARCHITECTURE.md "PR4" pour le détail complet). Copier en .env.local
# et renseigner les valeurs réelles — ce fichier ne contient aucun secret.

# ── Classification (PR1, optionnel) ─────────────────────────────────────────
# Active le repli Claude Haiku pour les documents ambigus après les règles
# déterministes. Sans elle, un document non reconnu par les règles reste au
# résultat déterministe (jamais de classification inventée).
ANTHROPIC_API_KEY=

# Seuils de confiance (optionnels, défauts 0.90 / 0.75).
CLASSIFICATION_AUTO_THRESHOLD=0.90
CLASSIFICATION_REVIEW_THRESHOLD=0.75

# ── Notion — bases de pilotage (PR4) ────────────────────────────────────────
# Clé API de l'intégration Notion utilisée par l'importateur (distincte ou
# identique à celle de app/api/_notion.js — les deux ciblent des bases
# différentes et ne se marchent jamais dessus).
NOTION_API_KEY=

# Les 5 IDs de base ci-dessous peuvent rester vides en développement : le
# client Notion échoue alors de façon explicite (CONFIG_MISSING) plutôt que
# de deviner ou de planter silencieusement. Voir docs/ARCHITECTURE.md "PR4"
# "Checklist de mise en place" pour créer/partager les bases et récupérer
# ces IDs.
NOTION_IMPORT_RUNS_DB_ID=
NOTION_DAILY_OPERATIONS_DB_ID=
NOTION_PAYMENT_METHODS_DB_ID=
NOTION_PRODUCT_SALES_DB_ID=
NOTION_SALES_CATEGORIES_DB_ID=

# ── Établissements (PR4) ─────────────────────────────────────────────────────
# Allowlist explicite "clé:Nom affiché", séparés par des virgules. Jamais
# déduit du fichier importé — obligatoire pour tout --commit / import UI.
IMPORTS_ESTABLISHMENTS=moka-sxm:MÖKA Café SXM

# ── Authentification /imports et /api/imports/* (PR4) ───────────────────────
# HTTP Basic Auth — couche d'accès staff temporaire (voir
# docs/ARCHITECTURE.md "PR4" "Authentification"). Les deux variables sont
# requises en production ; leur absence bloque toute requête (401), jamais
# un accès ouvert par défaut.
IMPORTS_AUTH_USERNAME=
IMPORTS_AUTH_PASSWORD=

# Opt-out de développement UNIQUEMENT explicite — ne jamais déduire de
# NODE_ENV. Ne jamais activer en production.
IMPORTS_AUTH_DISABLED=false

# ── scan-z — source secondaire par photo (spec v3) ──────────────────────────
# Désactivée par défaut. Une photo de Z de caisse (OCR via Claude vision),
# jamais prioritaire sur AddicTill/L'Addition — voir docs/ARCHITECTURE.md
# "scan-z secondary source". Ne jamais activer sans avoir lu le document
# de conception (statut Import Runs "blocked" requis, propriétés
# audit_metadata/source_subtype à créer avant le premier usage réel).
IMPORTS_SCANZ_ENABLED=false

# Secret HMAC-SHA256 (aléatoire, ≥ 32 octets) signant le jeton de
# prévisualisation qui lie de façon infalsifiable les valeurs OCR brutes au
# hash de l'image, à l'établissement et à une expiration (30 min). Requis
# uniquement si IMPORTS_SCANZ_ENABLED=true — sans lui, la prévisualisation
# et la confirmation scan-z échouent explicitement (CONFIG_MISSING), jamais
# silencieusement. Générer par ex. avec : openssl rand -base64 48
IMPORTS_PREFLIGHT_TOKEN_SECRET=

# ── Recipe Catalogue foundation (lib/recipes) ───────────────────────────────
# PAS ENCORE CRÉÉES — voir docs/ARCHITECTURE.md "Recipe Catalogue foundation".
# L'ancien RECETTES_DB/MENU_DB (jamais câblés dans le code) ne sont pas
# réutilisables sans changement de schéma ; la décision "réutiliser en les
# complétant" vs "créer deux bases neuves" n'a pas encore été prise. Tant que
# ces deux variables restent vides, chaque route /api/recipes/* échoue
# explicitement (CONFIG_MISSING), jamais silencieusement, exactement comme
# les 5 bases de l'importateur ci-dessus avant leur configuration.
NOTION_SOLD_PRODUCTS_DB_ID=
NOTION_RECIPE_LINES_DB_ID=

# ── MÖKA OS v2 — Sprint 3, bases physiques (zones/équipements/tâches) ───────
# Créées via scripts/sprint3-create-databases.sh, sous la page Notion
# "MÖKA OS v2 — Bases" (elle-même sous la page existante "KAMO Ai", seul
# parent déjà partagé avec l'intégration — les intégrations internes ne
# peuvent pas créer de page à la racine du workspace via l'API).
NOTION_ZONES_PHYSIQUES_DB_ID=
NOTION_EQUIPEMENTS_DB_ID=
NOTION_TACHES_DB_ID=
